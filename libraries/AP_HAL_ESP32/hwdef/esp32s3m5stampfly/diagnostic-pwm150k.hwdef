# M5Stamp Fly brushed PWM 150 kHz experimental diagnostic build.
# EXPERIMENTAL: this is not the production default (32 kHz).
# Duty resolution is lower than at 32 kHz; motor/driver current and heating
# must be checked on the bench before relying on this configuration.
#
# This includes the local, gitignored diagnostic.hwdef so private Wi-Fi
# credentials and local transport settings stay outside git.
include diagnostic.hwdef

undef HAL_ESP32_FORCE_BRUSHED_RCOUT
undef HAL_ESP32_FORCE_BRUSHED_RCOUT_FREQ
undef HAL_ESP32_BRUSHED_RCOUT_MAX_FREQ

define HAL_ESP32_FORCE_BRUSHED_RCOUT 1
define HAL_ESP32_FORCE_BRUSHED_RCOUT_FREQ 150000
define HAL_ESP32_BRUSHED_RCOUT_MAX_FREQ 150000
